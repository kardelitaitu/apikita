---
// Usage Analytics page. Auth = session cookie from POST /auth/exchange.
// Imports the interactive island, which ships JS (marketing pages stay JS-free).
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import UsageAnalytics from '../../islands/usage/UsageAnalytics.astro';
---

<DashboardLayout title="Usage">
  <h1 class="text-2xl font-semibold tracking-tight">Usage</h1>
  <p class="mt-3 max-w-2xl text-sm text-slate-600">
    Token usage over time. Input, cache-read and output tokens are three separate
    classes with three separate rates — they are reported separately, never summed.
  </p>
  <UsageAnalytics />
</DashboardLayout>
