---
import AuthLayout from '../../layouts/AuthLayout.astro';

// docs/website/03-functional-spec.md lines 88-95, step 3: "/reset/confirm: new
// password -> saved -> all sessions invalidated". Line 95 is the token rule this
// page has to keep: "never echoed back in a URL that gets logged".
const heading = 'Set a new password';
const lead = 'Choose a new password. Saving it signs out every session on this account, including any device you are not holding.';
---

<AuthLayout
  title="Set a new password — apikita"
  description="Choose a new password for your apikita account."
  heading={heading}
  lead={lead}
>
  <form id="reset-confirm" class="mt-6 space-y-4">
    <div id="email-field" hidden>
      <label for="email" class="block text-sm font-medium">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
      <p class="mt-1 text-xs text-ink-muted">
        The address this reset was requested for. Usually filled in from the link.
      </p>
    </div>
    <div>
      <label for="password" class="block text-sm font-medium">New password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
        aria-describedby="password-rules"
        class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
      <p id="password-rules" class="mt-1 text-xs text-ink-muted">
        At least 8 characters. Shown before you submit, not after it fails.
      </p>
    </div>
    <div>
      <label for="password-confirm" class="block text-sm font-medium">Confirm new password</label>
      <input
        id="password-confirm"
        name="passwordConfirm"
        type="password"
        autocomplete="new-password"
        minlength="8"
        required
        class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm focus:border-brand focus:outline-none"
      />
    </div>
    <button
      id="reset-confirm-submit"
      type="submit"
      class="w-full rounded-md bg-brand px-4 py-2.5 text-sm font-medium text-brand-ink hover:bg-brand-strong disabled:cursor-not-allowed disabled:cursor-not-allowed disabled:opacity-50"
    >
      Save new password
    </button>
  </form>
</AuthLayout>

<script>
  import { confirmPasswordReset } from '../../lib/auth-api';
  import { confirmationError, describeAuthError, passwordRuleError, PASSWORD_RESET_DONE_MESSAGE, readAuthEmail, readAuthToken, withoutAuthToken } from '../../lib/auth-flow';

  const errorBox = document.getElementById('auth-error') as HTMLDivElement;
  const done = document.getElementById('auth-done') as HTMLDivElement;
  const doneMessage = document.getElementById('auth-done-message') as HTMLDivElement;
  const form = document.getElementById('reset-confirm') as HTMLFormElement;
  const submit = document.getElementById('reset-confirm-submit') as HTMLButtonElement;

  const token = readAuthToken(window.location.search);
  const emailField = document.getElementById('email-field') as HTMLDivElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;

  // The link carries the address, because the API's confirm endpoint requires the
  // token and the address to AGREE and will refuse a pair that does not. Reading it
  // from the query beats asking the user to retype what they typed a minute ago;
  // the field below is the fallback for a link that arrived without one.
  const address = readAuthEmail(window.location.search);
  if (address !== null) {
    emailInput.value = address;
  } else {
    emailField.hidden = false;
    emailInput.required = true;
  }

  // Spec line 95: the token must not be echoed back in a URL that gets logged.
  // Removed from the address bar before the request, so it is not in the history
  // entry, in a copied link, or in the referrer of the next navigation. The token
  // is never written to the title, to storage, or to any other place — it lives
  // only in this closure.
  //
  // The ADDRESS is not stripped with it: it is not a credential, it is the value
  // the user is about to submit, and leaving it visible would be the more honest
  // state. Only the token is a secret.
  if (token !== null) {
    window.history.replaceState(null, '', withoutAuthToken(window.location.href));
  }

  function showError(message: string): void {
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  function setBusy(busy: boolean): void {
    submit.disabled = busy;
  }

  if (token === null) {
    form.hidden = true;
    showError('This reset link is invalid or has expired. Request a new one.');
    document.getElementById('auth-done')!.hidden = false;
  } else {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      errorBox.textContent = '';

      const data = new FormData(form);
      const password = String(data.get('password') ?? '');
      const confirmation = String(data.get('passwordConfirm') ?? '');
      const addressTyped = String(data.get('email') ?? emailInput.value).trim();

      const local = passwordRuleError(password) ?? confirmationError(password, confirmation);
      if (local !== null) {
        showError(local);
        return;
      }
      // The API refuses a token/address pair that disagrees, so an empty address
      // is worth catching here: the 401 it would earn says nothing about which of
      // the two was wrong.
      if (addressTyped === '') {
        showError('Enter the email address this reset was requested for.');
        return;
      }

      setBusy(true);
      // ONE request BY DESIGN, and the order of the three things the handler does
      // is the security property: it consumes the token, sets the hash, and THEN
      // revokes every live session on the account. A reset is what someone does
      // when they believe their credential leaked, so a session opened with the
      // old password surviving it would defeat the whole gesture. Nothing needs
      // clearing here — every one of those sessions was server-side, and the
      // browser's cookie is already dead.
      void confirmPasswordReset(token, addressTyped, password)
        .then(() => {
          form.hidden = true;
          doneMessage.textContent = PASSWORD_RESET_DONE_MESSAGE;
          done.hidden = false;
        })
        .catch((err: unknown) => showError(describeAuthError(err, 'Request a new reset link.')))
        .finally(() => setBusy(false));
    });
  }
</script>
