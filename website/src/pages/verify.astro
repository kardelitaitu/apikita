---
import AuthLayout from '../layouts/AuthLayout.astro';

// docs/website/03-functional-spec.md line 12: "Email verification landing".
// Line 32: the user clicks the link, lands here, and the account becomes active.
// PocketBase sends the token in the URL; the page consumes it once.
const heading = 'Verifying your email';
const lead = 'This is where the link in your verification email lands. We confirm the token with PocketBase, and the account becomes active the moment it is accepted.';
---

<AuthLayout
  title="Verify your email — apikita"
  description="Confirm the verification link for your apikita account."
  heading={heading}
  lead={lead}
>
  <div id="verify-pending" class="mt-6 text-sm text-ink-muted">Checking your link&hellip;</div>

  <div id="verify-outcome" hidden class="mt-6 space-y-4">
    <div
      id="verify-message"
      role="status"
      aria-live="polite"
      class="rounded-lg border border-edge-strong bg-surface-sunken p-3 text-sm text-ink"
    ></div>
    <p class="text-sm">
      <a href="/login" class="font-medium underline">Go to sign in</a>
    </p>
  </div>
</AuthLayout>

<script>
  import { pb } from '../lib/pocketbase';
  import { isUnreachable, readAuthToken, UNREACHABLE_MESSAGE, VERIFICATION_FAILED_MESSAGE, withoutAuthToken } from '../lib/auth-flow';

  const pending = document.getElementById('verify-pending') as HTMLDivElement;
  const outcome = document.getElementById('verify-outcome') as HTMLDivElement;
  const message = document.getElementById('verify-message') as HTMLDivElement;

  const token = readAuthToken(window.location.search);

  // Spec line 95: the token must not be echoed back in a URL that gets logged.
  // Dropped from the address bar before the request goes out, so it is gone from
  // the history entry, from a copy of the link, and from the referrer of the
  // next navigation. PocketBase keeps its own copy in localStorage — that is the
  // SDK's store, not a URL.
  if (token !== null) {
    window.history.replaceState(null, '', withoutAuthToken(window.location.href));
  }

  function finish(text: string): void {
    pending.hidden = true;
    message.textContent = text;
    outcome.hidden = false;
  }

  if (token === null) {
    finish(VERIFICATION_FAILED_MESSAGE);
  } else {
    void pb.collection('users').confirmVerification(token)
      .then(() => finish('Your email address is verified. Sign in to reach the dashboard.'))
      // One message for every unusable token: expired, already used, or simply
      // wrong. PocketBase clears a token when it is redeemed, so "already
      // verified" arrives here as an unusable token and lands on the same line,
      // with the same next step.
      .catch((err: unknown) => finish(isUnreachable(err) ? UNREACHABLE_MESSAGE : VERIFICATION_FAILED_MESSAGE));
  }
</script>
