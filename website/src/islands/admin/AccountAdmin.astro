---
// The operator account console: look up one account by id, read its
// state, and suspend or resume it.
//
// A script-island (plain <script>), not a UI-framework component — the same
// choice KeyManagement.astro documents: astro.config and package.json are not
// this file's to change.
//
// Gate: the page renders this only for an operator (the server re-checks
// anyway). Everything an operator sees here is a rendering decision; the
// authorization lives in server/src/routes/admin.rs.
//
// Contract: docs/admin-surface.md, docs/server/api-spec.md (Admin routes).
import Skeleton from '../../components/Skeleton.astro';
---

<!--
  The gate. Shown while /api/me is in flight and for a non-operator. The console
  below is revealed only for an operator. This is presentation, NOT security:
  every admin route answers 403 to a non-operator regardless of what is on
  screen (server/src/routes/admin.rs::require_operator).
-->
<div id="admin-gate" class="mt-6 rounded-lg border border-edge bg-surface-raised p-6 text-sm text-ink-muted">
  <p id="admin-gate-text">Checking operator access&hellip;</p>
  <p class="mt-3"><a href="/dashboard" class="underline">Back to your dashboard</a></p>
</div>

<div id="admin-island" hidden class="mt-6">
  <!-- Browse / search ------------------------------------------------------- -->
  <section aria-labelledby="admin-browse-heading">
    <h2 id="admin-browse-heading" class="text-lg font-semibold tracking-tight">Accounts</h2>
    <p class="mt-1 text-sm text-ink-muted">
      Browse every account, or filter by account id. There is no email search —
      email lives in the identity provider, not here.
    </p>

    <form id="admin-filter" class="mt-4 flex flex-wrap items-end gap-3">
      <div class="w-full flex-1 sm:w-auto sm:min-w-[18rem]">
        <label for="admin-q" class="block text-sm font-medium">Filter</label>
        <input id="admin-q" name="q" type="search" autocomplete="off" spellcheck="false"
          placeholder="Account id, or leave blank for all"
          class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 font-mono text-sm" />
      </div>
      <div>
        <label for="admin-status-filter" class="block text-sm font-medium">Status</label>
        <select id="admin-status-filter" name="status"
          class="mt-1 rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm">
          <option value="">Any</option>
          <option value="active">Active</option>
          <option value="suspended">Suspended</option>
          <option value="closed">Closed</option>
        </select>
      </div>
      <button id="admin-apply" type="submit"
        class="rounded-md border border-edge-strong px-4 py-2 text-sm font-medium hover:border-brand">Apply</button>
      <button id="admin-clear" type="button"
        class="rounded-md px-3 py-2 text-sm text-ink-muted hover:text-brand">Clear</button>
    </form>

    <div id="admin-list-error" hidden role="alert"
      class="mt-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

    <p id="admin-list-status" class="mt-4 text-sm text-ink-muted" aria-live="polite">Loading accounts&hellip;</p>

    <div id="admin-list-loading" class="mt-2 rounded-lg border border-edge bg-surface-raised p-4">
      <Skeleton width="w-full" lines={4} />
    </div>

    <div id="admin-list-wrap" hidden class="mt-2 overflow-x-auto rounded-lg border border-edge">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-edge-strong bg-surface-sunken">
            <th scope="col" class="px-3 py-2 font-medium">Account id</th>
            <th scope="col" class="px-3 py-2 font-medium">Status</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Balance</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Sessions</th>
            <th scope="col" class="px-3 py-2 text-right font-medium">Keys</th>
            <th scope="col" class="px-3 py-2 font-medium"></th>
          </tr>
        </thead>
        <tbody id="admin-list-rows"></tbody>
      </table>
    </div>

    <div class="mt-3 flex items-center justify-between gap-3">
      <button id="admin-prev" type="button" hidden
        class="rounded-md border border-edge-strong px-3 py-1.5 text-sm font-medium hover:border-brand">Previous</button>
      <span></span>
      <button id="admin-next" type="button" hidden
        class="rounded-md border border-edge-strong px-3 py-1.5 text-sm font-medium hover:border-brand">Next</button>
    </div>
  </section>

  <hr class="my-8 border-edge" />

  <!-- Recent operator actions (all accounts) -------------------------------- -->
  <section aria-labelledby="admin-recent-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="admin-recent-heading" class="text-lg font-semibold tracking-tight">Recent operator actions</h2>
      <button id="admin-recent-refresh" type="button"
        class="rounded-md border border-edge-strong px-3 py-1.5 text-xs font-medium hover:border-brand">Refresh</button>
    </div>
    <p class="mt-1 text-sm text-ink-muted">
      The latest actions across every account, newest first. This is the overview
      that catches an action taken on the wrong account without needing to know
      which account to look at.
    </p>

    <div id="admin-recent-error" hidden role="alert"
      class="mt-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

    <p id="admin-recent-loading" class="mt-4 text-sm text-ink-muted">Loading actions&hellip;</p>

    <p id="admin-recent-empty" hidden class="mt-4 text-xs text-ink-muted">
      No operator action has been recorded yet.
    </p>

    <ul id="admin-recent-list" hidden class="mt-4 divide-y divide-edge rounded-lg border border-edge"></ul>
  </section>

  <hr class="my-8 border-edge" />

  <!-- Service metrics ------------------------------------------------------- -->
  <section aria-labelledby="admin-metrics-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="admin-metrics-heading" class="text-lg font-semibold tracking-tight">Service metrics</h2>
      <span id="admin-metrics-badge" class="rounded border border-edge-strong px-2 py-0.5 text-xs font-medium text-ink-muted">—</span>
    </div>
    <p class="mt-1 text-sm text-ink-muted">
      In-process response counters since this server started. The error rate is
      5xx responses over all responses, and the alert threshold is 5%
      (<code class="font-mono">tools/alert</code>).
    </p>

    <div id="admin-metrics-error" hidden role="alert"
      class="mt-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

    <div id="admin-metrics-grid" hidden class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Responses</div>
        <div id="metrics-responses" class="mt-1 font-mono tabular-nums">—</div>
      </div>
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Server errors (5xx)</div>
        <div id="metrics-errors" class="mt-1 font-mono tabular-nums">—</div>
      </div>
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Error rate</div>
        <div id="metrics-rate" class="mt-1 font-mono tabular-nums">—</div>
      </div>
    </div>
  </section>

  <hr class="my-8 border-edge" />

  <!-- Lookup ---------------------------------------------------------------- -->
  <form id="admin-lookup" class="flex flex-wrap items-end gap-3">
    <div class="w-full flex-1 sm:w-auto sm:min-w-[22rem]">
      <label for="admin-account-id" class="block text-sm font-medium">Account id</label>
      <input id="admin-account-id" name="account_id" type="text" required autocomplete="off"
        spellcheck="false" placeholder="00000000-0000-0000-0000-000000000000"
        class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 font-mono text-sm" />
    </div>
    <button id="admin-lookup-btn" type="submit"
      class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Look up</button>
  </form>

  <div id="admin-error" hidden class="mt-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

  <!-- Result ---------------------------------------------------------------- -->
  <section id="admin-result" hidden class="mt-6">
    <div class="rounded-lg border border-edge bg-surface-raised p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold tracking-tight">Account</h2>
        <span id="admin-status" class="rounded border px-2 py-0.5 text-xs font-medium"></span>
      </div>

      <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-muted">Balance</dt>
          <dd id="admin-balance" class="mt-1 font-mono tabular-nums text-accent">&mdash;</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-muted">Live sessions</dt>
          <dd id="admin-sessions" class="mt-1 font-mono tabular-nums">0</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-muted">Live keys</dt>
          <dd id="admin-keys" class="mt-1 font-mono tabular-nums">0</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-ink-muted">Created</dt>
          <dd id="admin-created" class="mt-1 font-mono text-sm">&mdash;</dd>
        </div>
      </dl>

      <p id="admin-operator-note" hidden class="mt-4 rounded-md border border-edge-strong bg-surface-sunken p-3 text-xs text-ink-muted">
        This account is an operator. Operator accounts cannot act on each other
        through this surface, and an operator cannot act on their own account.
      </p>

      <!-- Actions -->
      <div class="mt-6 border-t border-edge pt-5">
        <h3 class="text-sm font-semibold">Actions</h3>
        <p id="admin-action-hint" class="mt-1 text-xs text-ink-muted"></p>

        <div id="admin-actions" class="mt-3 flex flex-wrap gap-3">
          <button id="admin-suspend" type="button" hidden
            class="rounded-md border border-danger-edge bg-danger-surface px-4 py-2 text-sm font-medium text-danger-ink hover:border-danger">Suspend account</button>
          <button id="admin-resume" type="button" hidden
            class="rounded-md border border-ok-edge bg-ok-surface px-4 py-2 text-sm font-medium text-ok-ink hover:border-ok">Resume account</button>
        </div>

        <p id="admin-terminal-note" hidden class="mt-3 text-xs text-ink-muted">
          A closed account is terminal: it can be neither suspended nor resumed.
        </p>
      </div>

      <!-- Audit trail -->
      <div class="mt-6 border-t border-edge pt-5">
        <h3 class="text-sm font-semibold">Audit trail</h3>
        <p class="mt-1 text-xs text-ink-muted">
          Every operator action on this account, newest first. The trail is the
          record that makes a dispute resolvable, so it is shown, not hidden.
        </p>

        <div id="admin-audit-error" hidden role="alert"
          class="mt-3 rounded-md border border-danger-edge bg-danger-surface p-3 text-sm text-danger-ink"></div>

        <p id="admin-audit-loading" class="mt-3 text-sm text-ink-muted">Loading trail&hellip;</p>

        <p id="admin-audit-empty" hidden class="mt-3 text-xs text-ink-muted">
          No operator action has been taken on this account.
        </p>

        <ul id="admin-audit-list" hidden class="mt-3 divide-y divide-edge rounded-md border border-edge"></ul>
      </div>
    </div>
  </section>

  <!-- Confirmation dialog ---------------------------------------------------- -->
  <div id="admin-confirm" hidden class="fixed inset-0 z-20 flex items-center justify-center bg-surface-sunken/80 p-4 backdrop-blur-sm"
    role="dialog" aria-modal="true" aria-labelledby="admin-confirm-title">
    <div class="w-full max-w-lg rounded-xl border border-edge-strong bg-surface-raised p-6 shadow-2xl shadow-black/60">
      <h2 id="admin-confirm-title" class="text-lg font-semibold tracking-tight"></h2>
      <p id="admin-confirm-body" class="mt-3 text-sm text-ink-muted"></p>
      <div class="mt-6 flex justify-end gap-3">
        <button id="admin-confirm-cancel" type="button"
          class="rounded-md border border-edge-strong px-4 py-2 text-sm font-medium hover:border-brand">Cancel</button>
        <button id="admin-confirm-go" type="button"
          class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Confirm</button>
      </div>
    </div>
  </div>

  <!-- Success notice --------------------------------------------------------- -->
  <div id="admin-done" hidden class="mt-4 rounded-lg border border-ok-edge bg-ok-surface p-4 text-sm text-ok-ink" role="status" aria-live="polite"></div>
</div>

<script>
  import { apiFetch } from '../../lib/api';
  import { describeError } from '../../lib/errors';
  import { formatIdr, formatCount } from '../../lib/format';
  import {
    accountAuditPath,
    accountListPath,
    accountPath,
    actionableAccountIds,
    actionPath,
    adminErrorMessage,
    auditActionLabel,
    auditDetailSummary,
    canResume,
    canSuspend,
    describeAction,
  describeActionTitle,
    errorRateBreached,
    formatAuditTime,
    formatErrorRate,
    metricsPath,
    type OperatorMetrics,
    hasNextPage,
    isAccountId,
    listSummary,
    recentAuditPath,
    type AccountStatus,
    type AdminAccount,
    type AdminAccountList,
    type AdminAccountSummary,
    type AdminActionResult,
    type AdminAuditList,
  } from '../../lib/admin';

  let current: AdminAccount | null = null;
  /** The operator's own account id, from /api/me. Used to exclude self from actions. */
  let operatorAccountId = '';

  // --- The operator gate ------------------------------------------------------
  // Read the operator flag from GET /api/me and reveal the console only for an
  // operator. A 401 is handled by apiFetch (redirect to /login); the gate just
  // stops rendering the console for everyone else, so no 403 is ever provoked
  // by a person who was never an operator.
  interface Me {
    account_id?: string;
    is_operator?: boolean;
  }
  const gate = document.getElementById('admin-gate') as HTMLElement;
  const gateText = document.getElementById('admin-gate-text') as HTMLElement;
  const islandRoot = document.getElementById('admin-island') as HTMLElement;

  async function checkOperator(): Promise<void> {
    try {
      const me = await apiFetch<Me>('/api/me');
      if (me.is_operator === true) {
        operatorAccountId = me.account_id ?? '';
        gate.hidden = true;
        islandRoot.hidden = false;
        void loadList();
        void loadRecentActions();
        void loadMetrics();
      } else {
        gateText.textContent = 'Operator access is required. This page is for operators only.';
      }
    } catch (err) {
      gateText.textContent = describeError(err).message;
    }
  }

  void checkOperator();

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  /** The page size both the console and the server default to. */
  const ADMIN_PAGE = 25;

  // --- Browse / search -------------------------------------------------------
  // The listing. It exists because lookup-by-id alone requires the operator to
  // already know a UUID, which is not "administering accounts". Every row here
  // goes through the same server authorization as the single view; the client
  // only decides what to render.
  const filterForm = $<HTMLFormElement>('admin-filter');
  const qInput = $<HTMLInputElement>('admin-q');
  const statusFilter = $<HTMLSelectElement>('admin-status-filter');
  const listError = $('admin-list-error');
  const listStatus = $('admin-list-status');
  const listWrap = $('admin-list-wrap');
  const listRows = $('admin-list-rows');
  const prevBtn = $<HTMLButtonElement>('admin-prev');
  const nextBtn = $<HTMLButtonElement>('admin-next');

  /** The current filter/page, the single source of truth for what is displayed. */
  let query = { q: '', status: '', offset: 0 };
  let lastList: AdminAccountList | null = null;

  function statusBadge(status: AccountStatus): string {
    switch (status) {
      case 'active':
        return 'border-ok-edge bg-ok-surface text-ok-ink';
      case 'suspended':
        return 'border-danger-edge bg-danger-surface text-danger-ink';
      default:
        return 'border-edge-strong bg-surface-sunken text-ink-muted';
    }
  }

  function rowFor(account: AdminAccountSummary): HTMLTableRowElement {
    const tr = document.createElement('tr');
    tr.className = 'border-b border-edge last:border-0 hover:bg-surface-sunken';

    const idCell = document.createElement('td');
    idCell.className = 'px-3 py-2 font-mono text-xs';
    idCell.textContent = account.account_id;
    tr.append(idCell);

    const statusCell = document.createElement('td');
    statusCell.className = 'px-3 py-2';
    const badge = document.createElement('span');
    badge.className = `rounded border px-2 py-0.5 text-xs font-medium ${statusBadge(account.status)}`;
    badge.textContent = account.status;
    statusCell.append(badge);
    if (account.is_operator) {
      const opBadge = document.createElement('span');
      opBadge.className = 'ml-1 rounded border border-warn-edge px-1.5 py-0.5 text-[0.65rem] font-medium uppercase text-warn';
      opBadge.textContent = 'operator';
      statusCell.append(opBadge);
    }
    tr.append(statusCell);

    for (const [text, cls] of [
      [formatIdr(account.balance_idr), 'px-3 py-2 text-right font-mono tabular-nums text-accent'],
      [String(account.live_sessions), 'px-3 py-2 text-right font-mono tabular-nums'],
      [String(account.live_keys), 'px-3 py-2 text-right font-mono tabular-nums'],
    ] as [string, string][]) {
      const td = document.createElement('td');
      td.className = cls;
      td.textContent = text;
      tr.append(td);
    }

    // The action cell: view always; suspend/resume only when the state allows and
    // it is not the operator's own row.
    const actionCell = document.createElement('td');
    actionCell.className = 'px-3 py-2 text-right whitespace-nowrap';
    const actionable = actionableAccountIds([account], operatorAccountId).size > 0;

    const viewBtn = document.createElement('button');
    viewBtn.type = 'button';
    viewBtn.className = 'text-xs font-medium text-brand hover:underline';
    viewBtn.textContent = 'Open';
    viewBtn.addEventListener('click', () => {
      input.value = account.account_id;
      void lookup(account.account_id);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    actionCell.append(viewBtn);

    if (actionable && canSuspend(account.status)) {
      actionCell.append(quickAction('Suspend', account.account_id, 'suspend'));
    } else if (actionable && canResume(account.status)) {
      actionCell.append(quickAction('Resume', account.account_id, 'resume'));
    }
    tr.append(actionCell);
    return tr;
  }

  function quickAction(label: string, id: string, action: 'suspend' | 'resume'): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'ml-2 text-xs font-medium hover:underline';
    btn.classList.add(action === 'suspend' ? 'text-danger' : 'text-ok');
    btn.textContent = label;
    btn.addEventListener('click', () => askConfirmFor(action, id));
    return btn;
  }

  function renderList(list: AdminAccountList): void {
    lastList = list;
    ($('admin-list-loading') as HTMLElement).hidden = true;
    listStatus.textContent = listSummary(list);
    listRows.replaceChildren(...list.accounts.map(rowFor));

    if (list.accounts.length === 0) {
      listWrap.hidden = true;
    } else {
      listWrap.hidden = false;
    }

    prevBtn.hidden = list.offset <= 0;
    nextBtn.hidden = !hasNextPage(list);
  }

  async function loadList(): Promise<void> {
    listError.hidden = true;
    listStatus.hidden = false;
    listStatus.textContent = 'Loading accounts…';
    ($('admin-list-loading') as HTMLElement).hidden = false;
    try {
      const list = await apiFetch<AdminAccountList>(
        accountListPath({ q: query.q, status: query.status, offset: query.offset }),
      );
      renderList(list);
    } catch (err) {
      const status = (err as { status?: number }).status ?? 0;
      listStatus.hidden = true;
      ($('admin-list-loading') as HTMLElement).hidden = true;
      listError.textContent = adminErrorMessage(status, describeError(err).message);
      listError.hidden = false;
    }
  }

  filterForm.addEventListener('submit', (event) => {
    event.preventDefault();
    query = { q: qInput.value.trim(), status: statusFilter.value, offset: 0 };
    void loadList();
  });

  $('admin-clear').addEventListener('click', () => {
    qInput.value = '';
    statusFilter.value = '';
    query = { q: '', status: '', offset: 0 };
    void loadList();
  });

  prevBtn.addEventListener('click', () => {
    query = { ...query, offset: Math.max(0, query.offset - ADMIN_PAGE) };
    void loadList();
  });
  nextBtn.addEventListener('click', () => {
    query = { ...query, offset: query.offset + ADMIN_PAGE };
    void loadList();
  });

  const form = $<HTMLFormElement>('admin-lookup');
  const input = $<HTMLInputElement>('admin-account-id');
  const errorBox = $('admin-error');
  const result = $('admin-result');
  const statusEl = $('admin-status');
  const balanceEl = $('admin-balance');
  const sessionsEl = $('admin-sessions');
  const keysEl = $('admin-keys');
  const createdEl = $('admin-created');
  const operatorNote = $('admin-operator-note');
  const hintEl = $('admin-action-hint');
  const suspendBtn = $<HTMLButtonElement>('admin-suspend');
  const resumeBtn = $<HTMLButtonElement>('admin-resume');
  const terminalNote = $('admin-terminal-note');
  const confirmBox = $('admin-confirm');
  const confirmTitle = $('admin-confirm-title');
  const confirmBody = $('admin-confirm-body');
  const doneBox = $('admin-done');

  // The banner is one element here, so it shows the message and the request id
  // on one line — the same shape the keys modal uses for its single-element
  // error surface (inlineNotice).
  function showNotice(err: unknown, override?: string): void {
    const view = describeError(err);
    const message = override ?? view.message;
    errorBox.textContent = view.requestId ? `${message} (${view.requestId})` : message;
    errorBox.hidden = false;
  }

  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  function statusClasses(status: AccountStatus): string {
    switch (status) {
      case 'active':
        return 'border-ok-edge bg-ok-surface text-ok-ink';
      case 'suspended':
        return 'border-danger-edge bg-danger-surface text-danger-ink';
      case 'closed':
        return 'border-edge-strong bg-surface-sunken text-ink-muted';
    }
  }

  function render(account: AdminAccount): void {
    current = account;

    statusEl.textContent = account.status;
    statusEl.className = `rounded border px-2 py-0.5 text-xs font-medium ${statusClasses(account.status)}`;

    balanceEl.textContent = formatIdr(account.balance_idr);
    sessionsEl.textContent = String(account.live_sessions);
    keysEl.textContent = String(account.live_keys);
    createdEl.textContent = account.created_at;

    operatorNote.hidden = !account.is_operator;

    // The controls, gated by the state the server will accept. A button is
    // shown only when the action can succeed; the reason it is absent is the
    // hint, so "nothing happened" is never a mystery.
    const maySuspend = canSuspend(account.status) && !account.is_operator;
    const mayResume = canResume(account.status) && !account.is_operator;
    suspendBtn.hidden = !maySuspend;
    resumeBtn.hidden = !mayResume;

    terminalNote.hidden = account.status !== 'closed';
    hintEl.hidden = maySuspend || mayResume;
    if (account.is_operator) {
      hintEl.textContent = 'Operator accounts cannot be acted on through this surface.';
      hintEl.hidden = false;
    } else if (account.status === 'closed') {
      hintEl.textContent = 'This account is closed and cannot be suspended or resumed.';
      hintEl.hidden = false;
    }

    result.hidden = false;
  }

  // --- The audit trail -------------------------------------------------------
  // Read GET /api/admin/accounts/:id/audit for the selected account. Loaded with
  // the account lookup, so selecting an account always shows its trail; a failure
  // here never blocks the account view itself.
  const auditError = $('admin-audit-error');
  const auditLoading = $('admin-audit-loading');
  const auditEmpty = $('admin-audit-empty');
  const auditList = $('admin-audit-list');

  function auditRow(entry: AdminAuditList['entries'][number]): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'p-3 text-sm';

    const head = document.createElement('div');
    head.className = 'flex flex-wrap items-baseline justify-between gap-2';

    const action = document.createElement('span');
    action.className = 'font-medium';
    action.textContent = auditActionLabel(entry.action);
    head.append(action);

    const when = document.createElement('span');
    when.className = 'text-xs text-ink-muted';
    when.textContent = formatAuditTime(entry.created_at);
    head.append(when);
    li.append(head);

    const summary = auditDetailSummary(entry.detail);
    if (summary !== null) {
      const d = document.createElement('p');
      d.className = 'mt-1 text-xs text-ink-muted';
      d.textContent = summary;
      li.append(d);
    }

    // The operator who acted, truncated for display but full in the title.
    const who = document.createElement('p');
    who.className = 'mt-1 font-mono text-[0.7rem] text-ink-subtle';
    who.textContent = 'operator ' + entry.operator_id.slice(0, 8) + '…';
    who.title = entry.operator_id;
    li.append(who);

    return li;
  }

  async function loadAudit(id: string): Promise<void> {
    auditError.hidden = true;
    auditEmpty.hidden = true;
    auditList.hidden = true;
    auditLoading.hidden = false;
    try {
      const page = await apiFetch<AdminAuditList>(accountAuditPath(id));
      auditLoading.hidden = true;
      if (page.entries.length === 0) {
        auditEmpty.hidden = false;
        return;
      }
      auditList.replaceChildren(...page.entries.map(auditRow));
      auditList.hidden = false;
    } catch (err) {
      auditLoading.hidden = true;
      const status = (err as { status?: number }).status ?? 0;
      auditError.textContent = adminErrorMessage(status, describeError(err).message);
      auditError.hidden = false;
    }
  }

  // --- Recent operator actions (all accounts) --------------------------------
  const recentError = $('admin-recent-error');
  const recentLoading = $('admin-recent-loading');
  const recentEmpty = $('admin-recent-empty');
  const recentList = $('admin-recent-list');

  async function loadRecentActions(): Promise<void> {
    recentError.hidden = true;
    recentEmpty.hidden = true;
    recentList.hidden = true;
    recentLoading.hidden = false;
    try {
      const page = await apiFetch<AdminAuditList>(recentAuditPath());
      recentLoading.hidden = true;
      if (page.entries.length === 0) {
        recentEmpty.hidden = false;
        return;
      }
      recentList.replaceChildren(...page.entries.map(auditRow));
      recentList.hidden = false;
    } catch (err) {
      recentLoading.hidden = true;
      const status = (err as { status?: number }).status ?? 0;
      recentError.textContent = adminErrorMessage(status, describeError(err).message);
      recentError.hidden = false;
    }
  }

  $('admin-recent-refresh').addEventListener('click', () => void loadRecentActions());

  // --- Service metrics -------------------------------------------------------
  const metricsError = $('admin-metrics-error');
  const metricsGrid = $('admin-metrics-grid');
  const metricsBadge = $('admin-metrics-badge');

  async function loadMetrics(): Promise<void> {
    metricsError.hidden = true;
    try {
      const m = await apiFetch<OperatorMetrics>(metricsPath());
      metricsGrid.hidden = false;
      $('metrics-responses').textContent = formatCount(m.responses);
      $('metrics-errors').textContent = formatCount(m.server_errors);
      $('metrics-rate').textContent = formatErrorRate(m.error_rate);

      const breached = errorRateBreached(m);
      metricsBadge.textContent = breached ? 'Above threshold' : 'Within threshold';
      metricsBadge.className =
        'rounded border px-2 py-0.5 text-xs font-medium ' +
        (breached ? 'border-warn bg-warn-surface text-warn-ink' : 'border-ok-edge text-ok');
    } catch (err) {
      const status = (err as { status?: number }).status ?? 0;
      metricsBadge.textContent = '—';
      metricsBadge.className = 'rounded border border-edge-strong px-2 py-0.5 text-xs font-medium text-ink-muted';
      metricsError.textContent = adminErrorMessage(status, describeError(err).message);
      metricsError.hidden = false;
    }
  }

  async function lookup(id: string): Promise<void> {
    clearError();
    doneBox.hidden = true;
    try {
      const account = await apiFetch<AdminAccount>(accountPath(id));
      render(account);
      // Load the trail alongside the account. Deliberately NOT awaited into the
      // same failure path: a trail that cannot load must not blank the account.
      void loadAudit(id);
    } catch (err) {
      result.hidden = true;
      current = null;
      // adminErrorMessage upgrades the operator-specific cases (403 -> "operator
      // access required"); anything else keeps the shared mapper's words.
      const status = (err as { status?: number }).status ?? 0;
      showNotice(err, adminErrorMessage(status, describeError(err).message));
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const id = input.value.trim();
    if (!isAccountId(id)) {
      errorBox.textContent = 'That is not a valid account id (expected a UUID).';
      errorBox.hidden = false;
      result.hidden = true;
      return;
    }
    void lookup(id);
  });

  // --- The confirmation flow ------------------------------------------------
  // ONE flow for both entry points: the detail pane's buttons and the row buttons
  // in the listing. The row buttons pass their own id, so the ACTION lands on the
  // account whose row was clicked rather than on whatever the detail pane happens
  // to be showing.
  //
  // AND THE DIALOG NAMES THAT ACCOUNT, in the title. It used not to: the comment
  // here claimed the confirmation "always names the account it is about to change",
  // which was half true. The id reached `pending` and so the right account WAS
  // changed, but `describeAction` returns the CONSEQUENCE and takes only the action,
  // so the dialog identified what would happen in detail and never which account it
  // would happen to. That is the worse of the two states for a confirmation: the body
  // is long, specific and authoritative about a revocation the operator cannot undo by
  // clicking cancel, and an operator with a list of accounts in front of them has no
  // way to check the dialog is about the one they meant.
  let pending: { action: 'suspend' | 'resume'; id: string } | null = null;

  function askConfirmFor(action: 'suspend' | 'resume', id: string): void {
    pending = { action, id };
    // The id is in the TITLE, so the consequence paragraph below can stay about the
    // consequence. An operator reads the title first, and this is the only place in the
    // dialog that says which account is about to be changed. Composed by
    // `describeActionTitle` rather than inline, because the island's script is not
    // something the website suite can reach - see that function for why it lives there.
    confirmTitle.textContent = describeActionTitle(action, id);
    confirmBody.textContent = describeAction(action);
    confirmBox.hidden = false;
  }

  function askConfirm(action: 'suspend' | 'resume'): void {
    if (!current) return;
    askConfirmFor(action, current.account_id);
  }

  suspendBtn.addEventListener('click', () => askConfirm('suspend'));
  resumeBtn.addEventListener('click', () => askConfirm('resume'));

  $('admin-confirm-cancel').addEventListener('click', () => {
    pending = null;
    confirmBox.hidden = true;
  });

  $('admin-confirm-go').addEventListener('click', () => {
    if (!pending) return;
    const { action, id } = pending;
    pending = null;
    confirmBox.hidden = true;
    void apply(action, id);
  });

  async function apply(action: 'suspend' | 'resume', id: string): Promise<void> {
    clearError();
    doneBox.hidden = true;
    try {
      const outcome = await apiFetch<AdminActionResult>(actionPath(id, action), { method: 'POST' });
      doneBox.textContent = action === 'suspend'
        ? `Account suspended. Revoked ${outcome.sessions_revoked} session(s) and ${outcome.keys_revoked} key(s).`
        : 'Account resumed. The customer must sign in again and create a new key.';
      doneBox.hidden = false;
      // Refresh both views: the detail pane (if it is showing this account) and
      // the listing row, so the two cannot disagree about the account's state.
      if (current?.account_id === id) await lookup(id);
      await loadList();
    } catch (err) {
      const status = (err as { status?: number }).status ?? 0;
      showNotice(err, adminErrorMessage(status, describeError(err).message));
    }
  }
</script>
