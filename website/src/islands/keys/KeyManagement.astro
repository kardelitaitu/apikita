---
// API Key Management island — key list + create-key modal.
// Frontend contract: docs/server/api-spec.md (Keys), docs/error-model.md,
// docs/website/06-api-keys-and-limits.md, docs/website/03-functional-spec.md.
// This is a script-island (plain <script>), not a UI-framework component:
// astro.config and package.json are owned by another worker and must not change.
import Skeleton from '../../components/Skeleton.astro';
const MODELS = ['flash', 'deepseek-v4-flash'];
---

<div id="key-island" class="mt-6">
  <!-- List ----------------------------------------------------------------- -->
  <div class="flex items-center justify-between">
    <div id="key-list-status" class="text-sm text-ink-muted" aria-live="polite">Loading keys…</div>
    <button id="create-key-btn" type="button"
      class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Create key</button>
  </div>

  <div id="key-error" hidden class="mt-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

  <div id="key-list-loading" class="mt-4 rounded-lg border border-edge bg-surface-raised p-4">
    <Skeleton width="w-full" lines={3} />
  </div>

  <ul id="key-list" class="mt-4 divide-y divide-edge rounded-lg border border-edge"></ul>

  <div id="key-empty" hidden class="mt-4 rounded-lg border border-edge bg-surface-raised p-6 text-sm text-ink-muted">
    <p class="font-medium text-ink">No API keys yet</p>
    <p class="mt-1">A key is the credential your program sends to
      <code class="font-mono">POST /v1/chat/completions</code>. Create one, then call the API —
      see the <a href="/docs/quickstart" class="underline">quickstart</a>.</p>
    <button id="key-empty-create" type="button"
      class="mt-4 rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Create your first key</button>
  </div>

  <!-- Create-key modal ------------------------------------------------------ -->
  <div id="key-modal" hidden class="fixed inset-0 z-20 flex items-center justify-center bg-surface-sunken/80 p-4 backdrop-blur-sm"
    role="dialog" aria-modal="true" aria-labelledby="key-modal-title">
    <div class="w-full max-w-lg rounded-xl border border-edge-strong bg-surface-raised p-6 shadow-2xl shadow-black/60">
      <!-- Step 1: the form -->
      <div id="key-form-step">
        <h2 id="key-modal-title" class="text-lg font-semibold tracking-tight">Create API key</h2>
        <p class="mt-2 text-sm text-ink-muted">Only a label is required. Leave limits at 0 for unlimited.</p>

        <form id="key-form" class="mt-4 space-y-4">
          <div>
            <label for="k-label" class="block text-sm font-medium">Label</label>
            <input id="k-label" name="label" type="text" required autocomplete="off" placeholder="e.g. prod"
              class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
          </div>

          <fieldset>
            <legend class="text-sm font-medium">Models</legend>
            <p class="text-xs text-ink-muted">Omitting models = all currently enabled models.</p>
            <div class="mt-2 flex flex-wrap gap-3">
              {MODELS.map((m) => (
                <label class="inline-flex items-center gap-2 text-sm">
                  <input type="checkbox" name="models" value={m} checked />
                  <span class="font-mono">{m}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label for="k-spend" class="block text-sm font-medium">Spend limit (IDR)</label>
              <input id="k-spend" name="spend_limit_idr" type="number" min="0" value="0"
                class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
            </div>
            <div>
              <label for="k-token" class="block text-sm font-medium">Token limit</label>
              <input id="k-token" name="token_limit" type="number" min="0" value="0"
                class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
            </div>
            <div>
              <label for="k-rate" class="block text-sm font-medium">Rate (req/min)</label>
              <input id="k-rate" name="rate_limit_rpm" type="number" min="0" value="0"
                class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
            </div>
          </div>

          <div>
            <label for="k-expires" class="block text-sm font-medium">Expires on</label>
            <input id="k-expires" name="expires_on" type="date"
              class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
            <p class="mt-1 text-xs text-ink-muted">Optional. The key works through the end of this day.
              Leave blank for a key that never expires.</p>
          </div>

          <div id="key-form-error" hidden class="rounded-md border border-danger-edge bg-danger-surface p-3 text-sm text-danger-ink"></div>

          <div class="flex justify-end gap-3 pt-2">
            <button id="key-cancel" type="button"
              class="rounded-md border border-edge-strong px-4 py-2 text-sm font-medium hover:border-brand">Cancel</button>
            <button id="key-submit" type="submit"
              class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Create key</button>
          </div>
        </form>
      </div>

      <!-- Step 2: the plaintext key, shown exactly once -->
      <div id="key-secret-step" hidden>
        <h2 class="text-lg font-semibold tracking-tight">Your new API key</h2>
        <div class="mt-3 rounded-md border border-warn-edge bg-warn-surface p-3 text-sm text-warn-ink">
          <strong>You will not see this key again.</strong> Store it somewhere safe now.
          The server keeps only its hash — if you lose it, revoke it and create a new one.
        </div>

        <div id="key-secret-missing" hidden class="mt-3 rounded-md border border-danger-edge bg-danger-surface p-3 text-sm text-danger-ink">
          The server created the key but did not return the plaintext value. This is unexpected —
          the key cannot be retrieved later. Treat it as unusable and revoke it from the list.
        </div>

        <div id="key-secret-wrap" class="mt-3 flex items-center gap-2">
          <code id="key-secret" class="block flex-1 break-all rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 font-mono text-sm"></code>
          <button id="key-copy" type="button"
            class="shrink-0 rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm font-medium hover:border-brand">Copy</button>
        </div>

        <div class="flex justify-end pt-4">
          <button id="key-done" type="button"
            class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">I've saved it</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit modal ------------------------------------------------------------- -->
  <div id="key-edit-modal" hidden class="fixed inset-0 z-20 flex items-center justify-center bg-surface-sunken/80 p-4 backdrop-blur-sm"
    role="dialog" aria-modal="true" aria-labelledby="key-edit-title">
    <div class="w-full max-w-lg rounded-xl border border-edge-strong bg-surface-raised p-6 shadow-2xl shadow-black/60">
      <h2 id="key-edit-title" class="text-lg font-semibold tracking-tight">Edit API key</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Change the label, model access, limits or expiry. The key itself never
        changes — its value stays the same.
      </p>

      <form id="key-edit-form" class="mt-4 space-y-4">
        <div>
          <label for="e-label" class="block text-sm font-medium">Label</label>
          <input id="e-label" name="label" type="text" required autocomplete="off"
            class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
        </div>

        <fieldset>
          <legend class="text-sm font-medium">Models</legend>
          <p class="text-xs text-ink-muted">An empty selection permits nothing — the allowlist is deny by default.</p>
          <div class="mt-2 flex flex-wrap gap-3">
            <label class="inline-flex items-center gap-2 text-sm">
              <input type="checkbox" name="models" value="flash" /> <span class="font-mono">flash</span>
            </label>
            <label class="inline-flex items-center gap-2 text-sm">
              <input type="checkbox" name="models" value="deepseek-v4-flash" /> <span class="font-mono">deepseek-v4-flash</span>
            </label>
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="e-spend" class="block text-sm font-medium">Spend limit (IDR)</label>
            <input id="e-spend" name="spend_limit_idr" type="number" min="0"
              class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="e-token" class="block text-sm font-medium">Token limit</label>
            <input id="e-token" name="token_limit" type="number" min="0"
              class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="e-rate" class="block text-sm font-medium">Rate (req/min)</label>
            <input id="e-rate" name="rate_limit_rpm" type="number" min="0"
              class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
          </div>
        </div>

        <div>
          <label for="e-expires" class="block text-sm font-medium">Expires on</label>
          <input id="e-expires" name="expires_on" type="date"
            class="mt-1 w-full rounded-md border border-edge-strong bg-surface-sunken px-3 py-2 text-sm" />
          <p class="mt-1 text-xs text-ink-muted">Blank = never expires.</p>
        </div>

        <div id="key-edit-warning" hidden class="rounded-md border border-warn-edge bg-warn-surface p-3 text-sm text-warn-ink"></div>
        <div id="key-edit-error" hidden class="rounded-md border border-danger-edge bg-danger-surface p-3 text-sm text-danger-ink"></div>

        <div class="flex justify-end gap-3 pt-2">
          <button id="key-edit-cancel" type="button"
            class="rounded-md border border-edge-strong px-4 py-2 text-sm font-medium hover:border-brand">Cancel</button>
          <button id="key-edit-submit" type="submit"
            class="rounded-md bg-brand px-4 py-2 text-sm font-medium text-brand-ink hover:bg-brand-strong">Save changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  import { apiFetch, ApiError } from '../../lib/api';
  import { describeError, inlineNotice, renderFieldError } from '../../lib/errors';
  import { formatIdr } from '../../lib/format';
  import {
    buildCreateKeyRequest,
    buildUpdateKeyRequest,
    limitReductionWarning,
    plaintextKeyOf,
    type ExistingKeyLimits,
  } from '../../lib/dashboard-form';

  const MODELS_ALL = ['flash', 'deepseek-v4-flash'];

  interface ApiKey {
    id: string;
    prefix: string;
    label: string;
    models: string[];
    spend_limit_idr: number;
    /** The token ceiling, 0 meaning unlimited. Mirrors ApiKeyDto in
     *  server/src/routes/keys.rs. It was absent from both, which is why the edit
     *  form could not populate the field and every save sent 0. */
    token_limit: number;
    spend_used_idr: number;
    rate_limit_rpm: number;
    expires_at: string | null;
    last_used_at: string | null;
    revoked_at: string | null;
  }

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const listEl = $('key-list');
  const statusEl = $('key-list-status');
  const errorEl = $('key-error');
  const emptyEl = $('key-empty');
  const modal = $('key-modal');

  function showError(msg: string): void {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }
  function clearError(): void {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function statusLabel(k: ApiKey): string {
    if (k.revoked_at) {
      const d = new Date(k.revoked_at);
      return 'Revoked' + (isNaN(d.getTime()) ? '' : ' · ' + d.toLocaleDateString());
    }
    if (k.expires_at) {
      const d = new Date(k.expires_at);
      if (!isNaN(d.getTime()) && d.getTime() <= Date.now()) return 'Expired';
    }
    return 'Active';
  }

  function spendText(k: ApiKey): string {
    if (!k.spend_limit_idr || k.spend_limit_idr <= 0) return 'Unlimited';
    return formatIdr(k.spend_used_idr) + ' / ' + formatIdr(k.spend_limit_idr) + ' (30d)';
  }

  function modelsText(k: ApiKey): string {
    if (!k.models || k.models.length === 0) return 'None (deny by default)';
    if (k.models.length >= MODELS_ALL.length) return 'All models';
    return k.models.length + ' model' + (k.models.length === 1 ? '' : 's');
  }

  function lastUsedText(k: ApiKey): string {
    if (!k.last_used_at) return 'Never';
    const d = new Date(k.last_used_at);
    return isNaN(d.getTime()) ? '—' : d.toLocaleString();
  }

  function render(keys: ApiKey[]): void {
    ($('key-list-loading') as HTMLElement).hidden = true;
    const hasAny = keys.length > 0;
    emptyEl.toggleAttribute('hidden', hasAny);
    listEl.toggleAttribute('hidden', !hasAny);
    statusEl.textContent = hasAny ? keys.length + ' key' + (keys.length === 1 ? '' : 's') : '';

    listEl.replaceChildren();
    for (const k of keys) {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center justify-between gap-4 p-4';

      // Built with createElement + textContent, never innerHTML. The label is
      // user-supplied and the prefix is server data: textContent has no escaping
      // to forget, so a label containing "<script>" renders as text rather than
      // being one missed case away from injection. Same rule as the usage and
      // admin islands.
      const left = document.createElement('div');

      const head = document.createElement('div');
      head.className = 'flex items-center gap-2';

      const label = document.createElement('span');
      label.className = 'font-medium';
      label.textContent = k.label || '(unlabeled)';
      head.append(label);

      const badge = document.createElement('span');
      badge.className =
        'rounded-full border px-2 py-0.5 text-xs ' +
        (k.revoked_at ? 'border-danger-edge text-danger' : 'border-ok-edge text-ok');
      badge.textContent = statusLabel(k);
      head.append(badge);

      const prefix = document.createElement('div');
      prefix.className = 'mt-1 font-mono text-sm text-ink-muted';
      prefix.textContent = k.prefix + '…';

      const summary = document.createElement('div');
      summary.className = 'mt-1 text-xs text-ink-muted';
      summary.textContent =
        'Models: ' + modelsText(k) +
        ' · Spend: ' + spendText(k) +
        ' · Last used: ' + lastUsedText(k);

      left.append(head, prefix, summary);
      const right = document.createElement('div');
      right.className = 'flex items-center gap-2';
      if (!k.revoked_at) {
        // Edit first: changing limits is the common action, revoking is not.
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'rounded-md border border-edge-strong px-3 py-1.5 text-sm font-medium hover:border-brand';
        edit.textContent = 'Edit';
        edit.addEventListener('click', () => openEdit(k));
        right.appendChild(edit);

        const revoke = document.createElement('button');
        revoke.type = 'button';
        revoke.className = 'rounded-md border border-danger-edge px-3 py-1.5 text-sm font-medium text-danger hover:bg-danger-surface';
        revoke.textContent = 'Revoke';
        revoke.addEventListener('click', () => confirmAndRevoke(k));
        right.appendChild(revoke);
      }
      li.append(left, right);
      listEl.appendChild(li);
    }
  }

  async function loadKeys(): Promise<void> {
    clearError();
    statusEl.textContent = 'Loading keys…';
    ($('key-list-loading') as HTMLElement).hidden = false;
    try {
      const keys = await apiFetch<ApiKey[]>('/api/keys');
      render(keys);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return;
      const view = describeError(err);
      showError(inlineNotice(view));
      render([]);
    }
  }

  // The plaintext key is held nowhere but the #key-secret node. Dismissing the
  // secret step must RELEASE it, not merely hide it: a 52-char credential must not
  // linger in a hidden DOM node for the lifetime of the page.
  function clearSecret(): void {
    ($('key-secret') as HTMLElement).textContent = '';
    ($('key-copy') as HTMLButtonElement).textContent = 'Copy';
  }

  function openModal(): void {
    clearError();
    // Reset path — a previous plaintext must never survive into a reopened modal.
    clearSecret();
    ($('key-form-step') as HTMLElement).hidden = false;
    ($('key-secret-step') as HTMLElement).hidden = true;
    ($('key-secret-missing') as HTMLElement).hidden = true;
    ($('key-secret-wrap') as HTMLElement).toggleAttribute('hidden', false);
    (modal as HTMLElement).hidden = false;
    ($('k-label') as HTMLInputElement).focus();
  }
  function closeModal(): void {
    (modal as HTMLElement).hidden = true;
    clearSecret();
    ($('key-form') as HTMLFormElement).reset();
    void loadKeys();
  }

  // --- Edit (PATCH /api/keys/:id) ------------------------------------------
  // The create form and the edit form share ONE request builder
  // (buildUpdateKeyRequest delegates to buildCreateKeyRequest), so the two cannot
  // disagree about which values are acceptable.
  const editModal = $('key-edit-modal');
  const editForm = $('key-edit-form') as HTMLFormElement;
  const editWarning = $('key-edit-warning');
  const editError = $('key-edit-error');
  /** The key being edited, and its stored limits (for the TTL warning). */
  let editing: { id: string; before: ExistingKeyLimits } | null = null;

  function openEdit(k: ApiKey): void {
    editing = {
      id: k.id,
      before: {
        spend_limit_idr: k.spend_limit_idr ?? 0,
        token_limit: k.token_limit ?? 0,
        rate_limit_rpm: k.rate_limit_rpm ?? 0,
      },
    };
    ($('e-label') as HTMLInputElement).value = k.label ?? '';
    ($('e-spend') as HTMLInputElement).value = String(k.spend_limit_idr ?? 0);
    // Read the token ceiling back, for the same reason the model boxes below are
    // read back: the submit path sends the whole field set, so anything this form
    // fails to populate is submitted as its blank default, and the blank default
    // for a limit is 0 - unlimited. This line is the difference between an edit
    // that keeps a key's ceiling and one that quietly removes it.
    ($('e-token') as HTMLInputElement).value = String(k.token_limit ?? 0);
    ($('e-rate') as HTMLInputElement).value = String(k.rate_limit_rpm ?? 0);
    ($('e-expires') as HTMLInputElement).value = k.expires_at ? k.expires_at.slice(0, 10) : '';
    // Preselect the key's existing allowlist. Reading it back is what keeps an
    // edit from silently widening access: an unchecked box means "not granted".
    const granted = new Set(k.models ?? []);
    for (const box of Array.from(editForm.querySelectorAll<HTMLInputElement>('input[name="models"]'))) {
      box.checked = granted.has(box.value);
    }
    editWarning.hidden = true;
    editError.hidden = true;
    editModal.hidden = false;
    ($('e-label') as HTMLInputElement).focus();
  }

  function closeEdit(): void {
    editModal.hidden = true;
    editing = null;
    editForm.reset();
  }

  $('key-edit-cancel').addEventListener('click', closeEdit);

  editForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!editing) return;
    editError.hidden = true;

    const data = new FormData(editForm);
    const built = buildUpdateKeyRequest({
      label: String(data.get('label') ?? ''),
      models: data.getAll('models').map(String),
      spend_limit_idr: String(data.get('spend_limit_idr') ?? ''),
      token_limit: String(data.get('token_limit') ?? ''),
      rate_limit_rpm: String(data.get('rate_limit_rpm') ?? ''),
      expires_on: String(data.get('expires_on') ?? ''),
    });
    if (!built.ok) {
      editError.textContent = built.error;
      editError.hidden = false;
      return;
    }

    const submit = $('key-edit-submit') as HTMLButtonElement;
    submit.disabled = true;
    submit.textContent = 'Saving…';
    const targetId = editing.id;
    const before = editing.before;
    void apiFetch<ApiKey>('/api/keys/' + encodeURIComponent(targetId), {
      method: 'PATCH',
      body: JSON.stringify(built.body),
    })
      .then(() => {
        const warning = limitReductionWarning(before, {
          spend_limit_idr: built.body.spend_limit_idr,
          token_limit: built.body.token_limit,
          rate_limit_rpm: built.body.rate_limit_rpm,
        });
        if (warning) {
          // Keep the modal open and SHOW the warning rather than closing
          // silently: docs/server/api-spec.md:187 requires the honest note that a
          // reduction is not instant.
          editWarning.textContent = warning + ' Your change has been saved.';
          editWarning.hidden = false;
          return;
        }
        closeEdit();
        void loadKeys();
      })
      .catch((err: unknown) => {
        editError.textContent = describeError(err).message;
        editError.hidden = false;
      })
      .finally(() => {
        submit.disabled = false;
        submit.textContent = 'Save changes';
      });
  });

  function openSecretStep(key: string | undefined): void {
    ($('key-form-step') as HTMLElement).hidden = true;
    ($('key-secret-step') as HTMLElement).hidden = false;
    const missing = ($('key-secret-missing') as HTMLElement);
    const wrap = ($('key-secret-wrap') as HTMLElement);
    const secret = $('key-secret') as HTMLElement;
    if (key) {
      missing.hidden = true;
      wrap.hidden = false;
      secret.textContent = key;
    } else {
      // Requirement #3: never invent a key. Surface the missing field instead.
      missing.hidden = false;
      wrap.hidden = true;
      secret.textContent = '';
    }
  }

  async function submitCreate(e: Event): Promise<void> {
    e.preventDefault();
    clearError();
    const form = e.currentTarget as HTMLFormElement;
    const fd = new FormData(form);
    const formErr = $('key-form-error') as HTMLElement;

    // Every limit and the expiry go through the tested helpers in
    // lib/dashboard-form.ts, so a bad value is refused here with a sentence the
    // user can act on rather than sent on to earn a 402 or a 422.
    const built = buildCreateKeyRequest({
      label: String(fd.get('label') ?? ''),
      models: Array.from(fd.getAll('models')).map(String),
      spend_limit_idr: String(fd.get('spend_limit_idr') ?? ''),
      token_limit: String(fd.get('token_limit') ?? ''),
      rate_limit_rpm: String(fd.get('rate_limit_rpm') ?? ''),
      expires_on: String(fd.get('expires_on') ?? ''),
    });
    if (!built.ok) {
      formErr.textContent = built.error;
      formErr.hidden = false;
      return;
    }

    const submitBtn = $('key-submit') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating…';
    try {
      const res = await apiFetch<{ id: string; key: string; prefix: string }>('/api/keys', {
        method: 'POST',
        body: JSON.stringify(built.body),
      });
      // Only the create response can reveal a key, and a missing field is never
      // invented — both rules live in plaintextKeyOf.
      const plaintext = plaintextKeyOf(res);
      if (plaintext === null) {
        openSecretStep(undefined);
        return;
      }
      openSecretStep(plaintext);
    } catch (err) {
      if (err instanceof ApiError) {
        // A 422 names the rejected input in details.field (docs/error-model.md),
        // so move focus to it instead of only writing the sentence. An error with
        // no field — or one this form does not know — still renders the notice.
        renderFieldError(formErr, describeError(err), {
          label: $('k-label'),
          spend_limit_idr: $('k-spend'),
          token_limit: $('k-token'),
          rate_limit_rpm: $('k-rate'),
          expires_on: $('k-expires'),
        });
      } else {
        formErr.textContent = err instanceof Error ? err.message : 'Could not create the key.';
      }
      formErr.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create key';
    }
  }

  async function confirmAndRevoke(k: ApiKey): Promise<void> {
    const ok = window.confirm(
      'Revoke "' + (k.label || k.prefix) + '"?' +
      '\n\nRevocation takes effect within about a minute (the proxy cache TTL), not instantly. ' +
      'This affects ALL surfaces — a key used via Telegram dies here too. This cannot be undone.'
    );
    if (!ok) return;
    clearError();
    try {
      await apiFetch<void>('/api/keys/' + k.id + '/revoke', { method: 'POST' });
      await loadKeys();
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return;
      const view = describeError(err);
      showError(inlineNotice(view));
    }
  }

  async function copyKey(): Promise<void> {
    const secret = ($('key-secret') as HTMLElement).textContent ?? '';
    const btn = $('key-copy') as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(secret);
      btn.textContent = 'Copied';
      window.setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
    } catch {
      btn.textContent = 'Copy failed';
      window.setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
    }
  }

  $('create-key-btn').addEventListener('click', openModal);
  $('key-empty-create')?.addEventListener('click', openModal);
  $('key-cancel').addEventListener('click', closeModal);
  $('key-done').addEventListener('click', closeModal);
  ($('key-form') as HTMLFormElement).addEventListener('submit', submitCreate);
  $('key-copy').addEventListener('click', copyKey);
  modal.addEventListener('click', (e) => {
    if (e.target === modal && !($('key-secret-step') as HTMLElement).hidden) closeModal();
  });

  void loadKeys();
</script>
