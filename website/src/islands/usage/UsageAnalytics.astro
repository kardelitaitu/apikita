---
// Usage Analytics island — the daily token breakdown.
// Frontend contract: docs/server/api-spec.md (GET /api/usage) and docs/realtime.md.
// The three token classes — input, cache_read, output — are kept as THREE SEPARATE
// counters and are NEVER summed into one figure. Cache-read is priced ~200x below
// output (docs/website/06-api-keys-and-limits.md), so a merged total cannot be
// reconciled against an invoice.
//
// Script-island (plain <script>), not a UI-framework component: astro.config and
// package.json are owned by another worker and must not change.
---

<div id="usage-island" class="mt-6">
  <div id="usage-error" hidden class="mb-4 rounded-lg border border-danger-edge bg-danger-surface p-4 text-sm text-danger-ink"></div>

  <section aria-labelledby="usage-today-h">
    <h2 id="usage-today-h" class="text-lg font-semibold tracking-tight">Today</h2>
    <p class="mt-1 text-sm text-ink-muted">
      Three separate counters. They are never added together — each class is billed on its own rate.
    </p>
    <div id="usage-today-grid" class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Input tokens</div>
        <div id="u-in" class="mt-1 font-mono text-lg tabular-nums">—</div>
      </div>
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Cache-read tokens</div>
        <div id="u-cache" class="mt-1 font-mono text-lg tabular-nums">—</div>
      </div>
      <div class="rounded-lg border border-edge bg-surface-raised p-4">
        <div class="text-xs uppercase tracking-wide text-ink-muted">Output tokens</div>
        <div id="u-out" class="mt-1 font-mono text-lg tabular-nums">—</div>
      </div>
    </div>
    <p class="mt-2 text-xs text-ink-muted">
      Cost today is shown for reference only; the token counters above are the source of truth for billing.
    </p>
  </section>

  <section class="mt-10" aria-labelledby="usage-trend-h">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="usage-trend-h" class="text-lg font-semibold tracking-tight">Trend</h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Trend metric">
        <button type="button" data-metric="input_tokens" class="trend-metric rounded-md border border-edge-strong px-3 py-1 text-xs font-medium">Input tokens</button>
        <button type="button" data-metric="output_tokens" class="trend-metric rounded-md border border-edge-strong px-3 py-1 text-xs font-medium">Output tokens</button>
        <button type="button" data-metric="cost_idr" class="trend-metric rounded-md border border-edge-strong px-3 py-1 text-xs font-medium">Cost</button>
      </div>
    </div>
    <p class="mt-1 text-sm text-ink-muted">
      One series at a time, on its own scale. The three token classes are not
      stacked: cache-read is priced ~200x below output, so a shared axis would
      imply a comparability that does not exist.
    </p>

    <p id="usage-trend-empty" hidden class="mt-4 rounded-lg border border-edge bg-surface-raised p-4 text-sm text-ink-muted">
      No usage in this period, so there is nothing to plot yet.
    </p>

    <div id="usage-trend-wrap" hidden class="mt-4 rounded-lg border border-edge bg-surface-raised p-4">
      <p id="usage-trend-caption" class="text-xs text-ink-muted"></p>
      <div class="mt-3 overflow-x-auto">
        <div id="usage-trend" class="flex h-40 min-w-full items-end gap-1"></div>
      </div>
    </div>
  </section>

  <section class="mt-10" aria-labelledby="usage-daily-h">
    <div class="flex items-center justify-between">
      <h2 id="usage-daily-h" class="text-lg font-semibold tracking-tight">Daily breakdown</h2>
      <div class="text-sm text-ink-muted" id="usage-daily-status" aria-live="polite">Loading…</div>
    </div>
    <p class="mt-1 text-sm text-ink-muted">Token classes are reported per day, separately — never as one summed number.</p>

    <div id="usage-daily-empty" hidden class="mt-4 rounded-lg border border-edge bg-surface-raised p-6 text-sm text-ink-muted">
      No usage recorded in this period yet. Create an API key, then call
      <code class="font-mono">POST /v1/chat/completions</code> — see the
      <a href="/docs/quickstart" class="underline">quickstart</a>.
    </div>

    <div class="mt-4 overflow-x-auto">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-edge-strong text-ink-muted">
            <th scope="col" class="py-2 pr-4 font-medium">Date</th>
            <th scope="col" class="py-2 pr-4 text-right font-medium">Input</th>
            <th scope="col" class="py-2 pr-4 text-right font-medium">Cache-read</th>
            <th scope="col" class="py-2 pr-4 text-right font-medium">Output</th>
            <th scope="col" class="py-2 text-right font-medium">Cost (IDR)</th>
          </tr>
        </thead>
        <tbody id="usage-rows" class="divide-y divide-edge"></tbody>
      </table>
      </div>
    </div>
  </section>
</div>

<script>
  import { apiFetch, ApiError } from '../../lib/api';
  import { describeError, inlineNotice } from '../../lib/errors';
  import { formatIdr, formatCount } from '../../lib/format';
  // The request window and the newest-bucket pick are pure rules, so they live in
  // lib/ and are pinned by tests/usage-window.test.ts. They cannot live in this
  // <script> block: astro does not type-check it and node --test cannot load it,
  // which is how `?from=-30d` (a 422 every load) shipped green.
  import { bucketDay, newestBucket, usageWindowQuery, type UsageBucket } from '../../lib/usage.ts';
  // The trend geometry is pure maths, pinned by tests/usage-trend.test.ts.
  import {
    buildTrend,
    metricLabel,
    shortDayLabel,
    trendHasData,
    type TrendMetric,
  } from '../../lib/usage-trend.ts';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const errorEl = $('usage-error');
  const statusEl = $('usage-daily-status');
  const rowsEl = $('usage-rows');
  // NOT `usage-empty`: /dashboard's own island owns that id and this island is
  // rendered on the same page (pages/dashboard.astro). Two writers, one id.
  const emptyEl = $('usage-daily-empty');

  function showError(msg: string): void {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }
  function clearError(): void {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  // Three counters, displayed separately. We never sum them. The only place a
  // single number appears is cost_idr, which is a money figure, not a token total.
  function renderToday(b: UsageBucket | null): void {
    $('u-in').textContent = b ? formatCount(b.input_tokens) : '—';
    $('u-cache').textContent = b ? formatCount(b.cache_read_tokens) : '—';
    $('u-out').textContent = b ? formatCount(b.output_tokens) : '—';
  }

  function renderRows(buckets: UsageBucket[]): void {
    const hasAny = buckets.some((b) =>
      b.input_tokens + b.cache_read_tokens + b.output_tokens > 0);
    emptyEl.toggleAttribute('hidden', hasAny);
    rowsEl.toggleAttribute('hidden', !hasAny);
    statusEl.textContent = hasAny ? buckets.length + ' day' + (buckets.length === 1 ? '' : 's') : '';

    rowsEl.replaceChildren();
    for (const b of buckets) {
      // Built with createElement + textContent, never innerHTML: every value here
      // is server data, and the one interpolated string (the day) is the exact
      // shape a hand-rolled escaper gets subtly wrong. textContent has no escaping
      // to forget — the same rule the admin console and the recent-requests table
      // follow.
      const tr = document.createElement('tr');

      const th = document.createElement('th');
      th.scope = 'row';
      th.className = 'py-2 pr-4 font-normal';
      th.textContent = bucketDay(b) ?? '—';
      tr.append(th);

      const cells: [string, string][] = [
        [formatCount(b.input_tokens), 'py-2 pr-4 text-right font-mono tabular-nums'],
        [formatCount(b.cache_read_tokens), 'py-2 pr-4 text-right font-mono tabular-nums'],
        [formatCount(b.output_tokens), 'py-2 pr-4 text-right font-mono tabular-nums'],
        [formatIdr(b.cost_idr), 'py-2 text-right font-mono tabular-nums'],
      ];
      for (const [text, className] of cells) {
        const td = document.createElement('td');
        td.className = className;
        td.textContent = text;
        tr.append(td);
      }

      rowsEl.appendChild(tr);
    }
  }

  // --- Trend ----------------------------------------------------------------
  // One series at a time, drawn as CSS-height bars (no chart dependency, no SVG
  // maths in the DOM). The last-loaded buckets are kept so switching the metric
  // redraws without a second request.
  let lastBuckets: UsageBucket[] = [];
  let metric: TrendMetric = 'input_tokens';
  const trendWrap = $('usage-trend-wrap');
  const trendEl = $('usage-trend');
  const trendEmpty = $('usage-trend-empty');
  const trendCaption = $('usage-trend-caption');

  function renderTrend(): void {
    const bars = buildTrend(lastBuckets, metric);
    const hasData = trendHasData(bars);
    trendEmpty.toggleAttribute('hidden', hasData);
    trendWrap.toggleAttribute('hidden', !hasData);
    if (!hasData) {
      trendEl.replaceChildren();
      return;
    }

    // The caption states the window and the metric, so the picture is never
    // ambiguous about either.
    const first = bars[0].day;
    const last = bars[bars.length - 1].day;
    trendCaption.textContent = `${metricLabel(metric)} — ${shortDayLabel(first)} to ${shortDayLabel(last)}, tallest day = 100%`;

    trendEl.replaceChildren();

    for (const bar of bars) {
      const col = document.createElement('div');
      col.className = 'flex h-full min-w-[6px] flex-1 flex-col justify-end';
      col.title = `${bar.day}: ${formatCount(rawValue(bar))}`;

      const fill = document.createElement('div');
      // A zero-height day still gets a hairline so the day is visible on the axis.
      fill.className = 'w-full rounded-t bg-brand';
      fill.style.height = bar.height === 0 ? '1px' : `${Math.round(bar.height * 100)}%`;
      if (bar.height === 0) fill.classList.add('opacity-30');
      col.append(fill);
      trendEl.append(col);
    }
  }

  function rawValue(bar: { input_tokens: number; output_tokens: number; cost_idr: number }): number {
    return metric === 'cost_idr' ? bar.cost_idr : metric === 'output_tokens' ? bar.output_tokens : bar.input_tokens;
  }

  for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>('.trend-metric'))) {
    btn.addEventListener('click', () => {
      metric = (btn.dataset.metric as TrendMetric) ?? 'input_tokens';
      renderTrend();
      syncMetricButtons();
    });
  }

  function syncMetricButtons(): void {
    for (const btn of Array.from(document.querySelectorAll<HTMLButtonElement>('.trend-metric'))) {
      const active = btn.dataset.metric === metric;
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.classList.toggle('bg-brand', active);
      btn.classList.toggle('text-brand-ink', active);
    }
  }

  // GET /api/usage returns daily buckets. Accept either a bare array or an
  // envelope ({ buckets | days | data }), and a trailing "today" snapshot if present.
  function parseUsage(payload: unknown): { buckets: UsageBucket[]; today: UsageBucket | null } {
    let buckets: UsageBucket[] = [];
    if (Array.isArray(payload)) {
      buckets = payload as UsageBucket[];
    } else if (payload && typeof payload === 'object') {
      const o = payload as Record<string, unknown>;
      const arr =
        (Array.isArray(o.buckets) && o.buckets) ||
        (Array.isArray(o.days) && o.days) ||
        (Array.isArray(o.data) && o.data) ||
        [];
      buckets = arr as UsageBucket[];
    }
    // The server orders `day DESC` (account.rs:190), so "today" is the newest
    // day, not the last element of the array.
    return { buckets, today: newestBucket(buckets) };
  }

  async function loadUsage(): Promise<void> {
    clearError();
    statusEl.textContent = 'Loading…';
    try {
      const payload = await apiFetch<unknown>('/api/usage' + usageWindowQuery());
      const { buckets, today } = parseUsage(payload);
      lastBuckets = buckets;
      renderToday(today);
      renderTrend();
      syncMetricButtons();
      renderRows(buckets);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return;
      const view = describeError(err);
      showError(inlineNotice(view));
      lastBuckets = [];
      renderToday(null);
      renderTrend();
      renderRows([]);
      statusEl.textContent = '';
    }
  }

  void loadUsage();
</script>
