---
import '../styles/global.css';

// Zero-JS base layout. No <script>, no client:* directives, ever.
interface Props {
  title: string;
  description: string;
  /** false = the caller supplies its own header/main/footer (dashboard shell). */
  chrome?: boolean;
}
const { title, description, chrome = true } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased">
    {chrome && (
    <header class="border-b border-edge">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
        <a href="/" class="font-semibold tracking-tight">apikita</a>
        <div class="flex gap-6 text-sm text-ink-muted">
          <a href="/#pricing" class="hover:text-brand">Pricing</a>
          <a href="/docs/quickstart" class="hover:text-brand">Quickstart</a>
        </div>
      </nav>
    </header>
    )}

    {chrome ? (
      <main class="mx-auto max-w-4xl px-6 py-12">
        <slot />
      </main>
    ) : (
      <slot />
    )}

    {chrome && (
    <footer class="border-t border-edge">
      <div class="mx-auto max-w-4xl px-6 py-8 text-sm text-ink-muted">
        <p>apikita &mdash; prepaid LLM API gateway. Prices in IDR.</p>
        <p class="mt-1">&copy; {year}</p>
      </div>
    </footer>
    )}
  </body>
</html>
