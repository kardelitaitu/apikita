---
import Base from './Base.astro';

// The shared frame for the public auth pages (/login, /signup, /verify, /reset,
// /reset/confirm). The markup is the one login.astro already used; only the
// header is parameterised, because the pages differ in their title, their
// explanation and their heading level and in nothing else.
interface Props {
  title: string;
  description: string;
  /** Page heading. h1 on a standalone page; h2 when it is a step inside one. */
  heading: string;
  level?: 'h1' | 'h2';
  lead?: string;
}
const { title, description, heading, level = 'h1', lead } = Astro.props;
const Heading = level;
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-sm py-8">
    <Heading class="text-2xl font-semibold tracking-tight">{heading}</Heading>
    {lead && <p class="mt-3 text-sm text-slate-600">{lead}</p>}

    <div
      id="auth-error"
      hidden
      role="alert"
      aria-live="polite"
      class="mt-6 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900"
    ></div>

    <div id="auth-done" hidden class="mt-6 space-y-4">
      <div
        id="auth-done-message"
        role="status"
        aria-live="polite"
        class="rounded-lg border border-slate-300 bg-slate-50 p-3 text-sm text-slate-700"
      ></div>
      <p class="text-sm">
        <a href="/login" class="font-medium underline">Go to sign in</a>
      </p>
    </div>

    <slot />

    <slot name="footnote" />
  </section>
</Base>
