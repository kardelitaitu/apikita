# =============================================================================
# apikita environment variables
# =============================================================================
# Copy to .env and fill in. .env is gitignored; THIS FILE IS COMMITTED.
# Never put a real key in this file.
#
#   cp .env.example .env
#
# .env is the local holding area. Northflank gets these as service env vars
# (either pasted into its dashboard or synced from a secret group); Cloudflare
# Pages gets its own public vars separately -- see "Cloudflare Pages" below.

# -----------------------------------------------------------------------------
# Upstream provider API keys
# -----------------------------------------------------------------------------
# One variable per KEY. A provider key usually has its own concurrency ceiling,
# so several keys per provider give the router a pool to rotate through.
# Names must match the api_key_envs arrays in config/apikita.toml.
#
# Blank = the router treats that key as absent and skips it.

# Provider 1 - primary (flash). The one real, terms-checked provider.
APK_FLASH_PRIMARY_KEY_1=
APK_FLASH_PRIMARY_KEY_2=
APK_FLASH_PRIMARY_KEY_3=

# Provider 2 - secondary (flash). Currently weight 0 / never routed.
# PLACEHOLDER: no such provider exists. Setting these keys does NOT enable it -
# routing follows the weight in config/apikita.toml, which is 0.0 - and it would
# send paying traffic to a host nobody has cleared to resell if that weight were
# raised without a real endpoint behind it.
APK_FLASH_SECONDARY_KEY_1=
APK_FLASH_SECONDARY_KEY_2=

# Provider 3 - tertiary (flash). Currently weight 0 / never routed.
APK_FLASH_TERTIARY_KEY_1=

# Legacy alias model name (deepseek-v4-flash)
APK_V4FLASH_PRIMARY_KEY_1=
APK_V4FLASH_PRIMARY_KEY_2=

# -----------------------------------------------------------------------------
# Payments - Midtrans (QRIS top-ups)
# -----------------------------------------------------------------------------
# Server key is SECRET. Client key is public and may be exposed to the browser.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
# "sandbox" or "production". Never ship production with sandbox.
MIDTRANS_ENV=sandbox
# Midtrans signs webhooks with SHA512(order_id + status_code + gross_amount +
# server_key). Verify it server-side. The server key is required to do that.
MIDTRANS_WEBHOOK_VERIFY=true

# -----------------------------------------------------------------------------
# Storage - wallet balances and billing
# -----------------------------------------------------------------------------
# Embedded SQLite. This is a FILE PATH, not a network URL:
#   sqlite://data/server.db
#
# Three things that bite on first run:
#   1. The parent directory must already exist. SQLite creates the database file
#      but never the directory, and a missing directory surfaces as
#      "unable to open database file".
#   2. There is deliberately no ?mode=rwc. sqlx defaults to create_if_missing =
#      false (measured in sqlx-sqlite 0.8.6, src/options/mod.rs:198), so the
#      server fails loudly when the database is absent instead of creating an
#      empty, schema-less one. Creating it is the migrate binary's job.
#   3. In production this path must resolve onto the persistent volume, or every
#      deploy loses the ledger. See docs/plans/sqlite-migration.md.
DATABASE_URL=sqlite://data/server.db

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# No identity environment variables are required. Identity is served by this
# crate over the `identities` table (server/src/identity/), configured through
# [auth] and [email] in config/apikita.toml. The APIKITA_PUBLIC_URL below is the
# only identity-related variable, and it is used to build verification and
# password-reset links.
#
# POCKETBASE_URL used to live here. It is gone along with the PocketBase client
# path: the API no longer calls anything for auth. Leave it set if you like —
# nothing reads it — but do not add it to a new deployment.

# -----------------------------------------------------------------------------
# Links in outbound mail
# -----------------------------------------------------------------------------
# The origin used to build verification and password-reset links, e.g.
# https://apikita.example/verify?token=...
# Bare origin, no trailing slash and no path. Unset falls back to
# https://apikita.example, which is a placeholder: a real deployment MUST set
# this or every mail link points at a domain nobody owns.
APIKITA_PUBLIC_URL=https://apikita.example

# Config file the server loads. Path is relative to the process CWD.
APIKITA_CONFIG_PATH=config/apikita.toml

# -----------------------------------------------------------------------------
# Server runtime (Northflank)
# -----------------------------------------------------------------------------
# Northflank injects PORT automatically; do not hardcode it in the app. The
# server already defaults to 8080 locally (see docs/local-development.md).
# PORT=8080
RUST_LOG=info
API_BASE_URL=https://api.example.com
# Base URL Midtrans calls back to. Must be publicly reachable HTTPS.
PUBLIC_WEBHOOK_URL=https://api.example.com/webhooks/midtrans

# -----------------------------------------------------------------------------
# Cloudflare Pages (website/)
# -----------------------------------------------------------------------------
# IMPORTANT: anything prefixed with PUBLIC_ or NEXT_PUBLIC_ is INLINED INTO
# BROWSER JAVASCRIPT AND IS NOT SECRET. Anyone can read it. Only put values
# here that are safe to publish. Real secrets stay on Northflank.
PUBLIC_API_BASE_URL=https://api.example.com
# The CLIENT key, not the server key above: it is inlined into the browser
# bundle and is public by design. Sandbox and production keys differ, so set
# this together with PUBLIC_MIDTRANS_ENV at build time.
PUBLIC_MIDTRANS_CLIENT_KEY=
# Browser-side mirror of MIDTRANS_ENV above: which Snap.js host the wallet page
# loads. ONLY an explicit "production" selects the live host -- anything else,
# including an unset value (local dev) or a typo, stays on sandbox, matching the
# server's rule in server/src/routes/account.rs. A mismatch between the two
# means the page loads Snap from one host while the server creates the token on
# the other, and every top-up silently fails.
PUBLIC_MIDTRANS_ENV=sandbox
PUBLIC_SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to use admin commands.
TELEGRAM_ADMIN_IDS=
